<?xml version="1.0"?>
<!--
  Delta 主动臂模型。
  结构参考 AntonSHBK/delta_robot_ros2 (MIT License)，尺寸改为本项目参数。
  URL:https://github.com/AntonSHBK/delta_robot_ros2.git
  主动臂零位沿 local +X，关节轴 local -Y，因此 URDF 关节角直接等于运动学 theta。
  动平台与从动臂不放进 URDF，由 topping_delta_sim 的 TF + Marker 发布。
-->
<robot name="topping_delta">
  <material name="base_gray">
    <color rgba="0.45 0.45 0.45 1.0"/>
  </material>
  <material name="arm_blue">
    <color rgba="0.20 0.40 0.90 1.0"/>
  </material>
  <material name="joint_yellow">
    <color rgba="0.95 0.75 0.10 1.0"/>
  </material>
  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 -0.010" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.139" length="0.020"/>
      </geometry>
      <material name="base_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.010" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.139" length="0.020"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.04"/>
    </inertial>
  </link>

  <!-- leg 1 -->
  <joint name="leg_1_base_joint" type="fixed">
    <origin xyz="0.139 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="leg_1_base"/>
  </joint>
  <link name="leg_1_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
      <material name="joint_yellow"/>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="leg_1_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="leg_1_base"/>
    <child link="leg_1_upper"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159265" upper="3.14159265" effort="20.0" velocity="10.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>
  <link name="leg_1_upper">
    <visual>
      <origin xyz="0.070 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.140"/>
      </geometry>
      <material name="arm_blue"/>
    </visual>
    <collision>
      <origin xyz="0.070 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.140"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.070 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- leg 2 -->
  <joint name="leg_2_base_joint" type="fixed">
    <origin xyz="-0.069500 0.120388 0" rpy="0 0 2.094395"/>
    <parent link="base_link"/>
    <child link="leg_2_base"/>
  </joint>
  <link name="leg_2_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
      <material name="joint_yellow"/>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="leg_2_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="leg_2_base"/>
    <child link="leg_2_upper"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159265" upper="3.14159265" effort="20.0" velocity="10.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>
  <link name="leg_2_upper">
    <visual>
      <origin xyz="0.070 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.140"/>
      </geometry>
      <material name="arm_blue"/>
    </visual>
    <collision>
      <origin xyz="0.070 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.140"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.070 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- leg 3 -->
  <joint name="leg_3_base_joint" type="fixed">
    <origin xyz="-0.069500 -0.120388 0" rpy="0 0 4.188790"/>
    <parent link="base_link"/>
    <child link="leg_3_base"/>
  </joint>
  <link name="leg_3_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
      <material name="joint_yellow"/>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="leg_3_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="leg_3_base"/>
    <child link="leg_3_upper"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159265" upper="3.14159265" effort="20.0" velocity="10.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>
  <link name="leg_3_upper">
    <visual>
      <origin xyz="0.070 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.140"/>
      </geometry>
      <material name="arm_blue"/>
    </visual>
    <collision>
      <origin xyz="0.070 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.140"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.070 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
</robot>
